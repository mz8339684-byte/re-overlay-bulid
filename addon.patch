diff --git a/external/IgcsConnector-main/src/OverlayPanel.cpp b/external/IgcsConnector-main/src/OverlayPanel.cpp
new file mode 100644
index 0000000..b61a935
--- /dev/null
+++ b/external/IgcsConnector-main/src/OverlayPanel.cpp
@@ -0,0 +1,333 @@
+#define IMGUI_DISABLE_INCLUDE_IMCONFIG_H
+
+#include "stdafx.h"
+#include <imgui.h>
+#include <algorithm>
+#include <cfloat>
+#include <cstdio>
+#include <cstring>
+#include <fstream>
+#include <memory>
+#include <string>
+#include <vector>
+
+#include "OverlayPanel.h"
+
+namespace overlaypanel
+{
+	namespace
+	{
+		struct Entry
+		{
+			bool  picture = false;
+			bool  visible = true;
+			float x = 0.5f, y = 0.5f;
+			float size = 0.2f;        // picture: width / frame width, text: em / frame height
+			float opacity = 1.0f;
+			float color[3] = { 1.f, 1.f, 1.f };
+			std::string content;      // text, or image file name
+		};
+
+		std::vector<Entry> g_entries;
+		std::vector<std::string> g_images;
+		bool g_loaded = false;
+		bool g_enabled = true;
+		int  g_pick = 0;
+		char g_newText[256] = "";
+		std::string g_baseDir, g_imageDir, g_file;
+
+		void initPaths()
+		{
+			char exe[MAX_PATH] = {};
+			GetModuleFileNameA(GetModuleHandleA(nullptr), exe, MAX_PATH);
+			// Rockstar Editor+ publishes its overlay folder in this variable
+			// (FiveM: the plugins folder, then RockstarEditorPlus, then overlay).
+			// Same process, so no file or protocol is needed.
+			char env[MAX_PATH] = {};
+			if (GetEnvironmentVariableA("REP_OVERLAY_DIR", env, MAX_PATH) > 0 && env[0])
+			{
+				g_baseDir = env;
+				if (g_baseDir.back() != '\\') g_baseDir += '\\';
+			}
+			else
+			{
+				// ASI not loaded (yet): the old single-player guess.
+				std::string d = exe;
+				d = d.substr(0, d.find_last_of("\\/") + 1);
+				CreateDirectoryA((d + "RockstarEditorPlus").c_str(), nullptr);
+				g_baseDir = d + "RockstarEditorPlus\\overlay\\";
+			}
+			CreateDirectoryA(g_baseDir.c_str(), nullptr);
+			g_imageDir = g_baseDir + "images\\";
+			CreateDirectoryA(g_imageDir.c_str(), nullptr);
+			g_file = g_baseDir + "overlay.txt";
+		}
+
+		std::string esc(const std::string& s)
+		{
+			std::string o;
+			for (char c : s)
+			{
+				if (c == '\\') o += "\\\\";
+				else if (c == '\t') o += "\\t";
+				else if (c == '\n' || c == '\r') o += "\\n";
+				else o += c;
+			}
+			return o;
+		}
+		std::string unesc(const std::string& s)
+		{
+			std::string o;
+			for (size_t i = 0; i < s.size(); ++i)
+			{
+				if (s[i] == '\\' && i + 1 < s.size()) { char n = s[++i]; o += (n == 't') ? '\t' : (n == 'n') ? '\n' : n; }
+				else o += s[i];
+			}
+			return o;
+		}
+
+		void save()
+		{
+			std::ofstream f(g_file, std::ios::trunc);
+			if (!f) return;
+			f << "#v1\t" << (g_enabled ? 1 : 0) << "\n";
+			char nums[160];
+			for (auto& e : g_entries)
+			{
+				snprintf(nums, sizeof(nums), "%.4f\t%.4f\t%.4f\t%.3f\t%d\t%d\t%d",
+					e.x, e.y, e.size, e.opacity,
+					(int)(e.color[0] * 255.f + 0.5f), (int)(e.color[1] * 255.f + 0.5f), (int)(e.color[2] * 255.f + 0.5f));
+				f << (e.picture ? "P" : "T") << '\t' << (e.visible ? 1 : 0) << '\t' << nums << '\t' << esc(e.content) << '\n';
+			}
+		}
+
+		void load()
+		{
+			g_loaded = true;
+			initPaths();
+			std::ifstream f(g_file);
+			std::string line;
+			while (f && std::getline(f, line))
+			{
+				if (line.empty()) continue;
+				std::vector<std::string> p;
+				size_t pos = 0;
+				for (int i = 0; i < 9; ++i)
+				{
+					size_t t = line.find('\t', pos);
+					if (t == std::string::npos) { p.push_back(line.substr(pos)); pos = line.size(); break; }
+					p.push_back(line.substr(pos, t - pos));
+					pos = t + 1;
+				}
+				if (p.size() >= 2 && p[0] == "#v1") { g_enabled = p[1] == "1"; continue; }
+				if (p.size() < 9) continue;
+				Entry e;
+				e.picture = p[0] == "P";
+				e.visible = p[1] == "1";
+				e.x = (float)atof(p[2].c_str()); e.y = (float)atof(p[3].c_str());
+				e.size = (float)atof(p[4].c_str()); e.opacity = (float)atof(p[5].c_str());
+				e.color[0] = atoi(p[6].c_str()) / 255.f; e.color[1] = atoi(p[7].c_str()) / 255.f; e.color[2] = atoi(p[8].c_str()) / 255.f;
+				e.content = unesc(pos < line.size() ? line.substr(pos) : "");
+				g_entries.push_back(std::move(e));
+			}
+		}
+
+		void refreshImages()
+		{
+			g_images.clear();
+			WIN32_FIND_DATAA fd;
+			HANDLE h = FindFirstFileA((g_imageDir + "*.*").c_str(), &fd);
+			if (h == INVALID_HANDLE_VALUE) return;
+			do
+			{
+				if (fd.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) continue;
+				std::string n = fd.cFileName, l = n;
+				std::transform(l.begin(), l.end(), l.begin(), ::tolower);
+				auto ends = [&](const char* x) { size_t k = strlen(x); return l.size() >= k && l.compare(l.size() - k, k, x) == 0; };
+				if (ends(".png") || ends(".jpg") || ends(".jpeg") || ends(".bmp") || ends(".gif")) g_images.push_back(n);
+			} while (FindNextFileA(h, &fd));
+			FindClose(h);
+			std::sort(g_images.begin(), g_images.end());
+			if (g_pick >= (int)g_images.size()) g_pick = 0;
+		}
+
+		bool g_preview = true;
+		int  g_highlight = -1;   // entry whose settings are open this frame
+
+		// Picture size from the file header (PNG / BMP / JPEG) so the preview
+		// box has the picture's real proportions. 0.0 = unknown.
+		float imageHeightOverWidth(const std::string& path)
+		{
+			std::ifstream f(path, std::ios::binary);
+			if (!f) return 0.f;
+			std::vector<unsigned char> d(1 << 20);
+			f.read((char*)d.data(), (std::streamsize)d.size());
+			d.resize((size_t)f.gcount());
+			long w = 0, h = 0;
+			if (d.size() >= 24 && d[0] == 0x89 && d[1] == 'P')
+			{
+				w = (d[16] << 24) | (d[17] << 16) | (d[18] << 8) | d[19];
+				h = (d[20] << 24) | (d[21] << 16) | (d[22] << 8) | d[23];
+			}
+			else if (d.size() >= 26 && d[0] == 'B' && d[1] == 'M')
+			{
+				w = *(int*)&d[18]; h = *(int*)&d[22]; if (h < 0) h = -h;
+			}
+			else if (d.size() > 4 && d[0] == 0xFF && d[1] == 0xD8)
+			{
+				for (size_t i = 2; i + 9 < d.size();)
+				{
+					if (d[i] != 0xFF) { ++i; continue; }
+					unsigned char m = d[i + 1];
+					if (m >= 0xC0 && m <= 0xCF && m != 0xC4 && m != 0xC8 && m != 0xCC)
+					{ h = (d[i + 5] << 8) | d[i + 6]; w = (d[i + 7] << 8) | d[i + 8]; break; }
+					i += 2 + ((d[i + 2] << 8) | d[i + 3]);
+				}
+			}
+			return (w > 0 && h > 0) ? (float)h / (float)w : 0.f;
+		}
+
+		// Draws where each entry will land in the render, on top of the game.
+		// Runs only while the ReShade overlay is open (that is when add-ons can
+		// draw), and is deliberately NOT part of the frame the renderer captures:
+		// the burn-in is done by Rockstar Editor+ on the saved frames.
+		// Text is the real text; a picture is a labelled box of the right shape
+		// (the picture itself is composited at render time).
+		void drawPreview()
+		{
+			if (!g_enabled || !g_preview) return;
+			ImDrawList* dl = ImGui::GetForegroundDrawList();
+			const ImVec2 ds = ImGui::GetIO().DisplaySize;
+			for (int i = 0; i < (int)g_entries.size(); ++i)
+			{
+				const Entry& e = g_entries[(size_t)i];
+				if (!e.visible) continue;
+				const float cx = e.x * ds.x, cy = e.y * ds.y;
+				const int a = (int)(255.f * e.opacity);
+				const bool hot = (i == g_highlight);
+				if (e.picture)
+				{
+					float r = imageHeightOverWidth(g_imageDir + e.content);
+					if (r <= 0.f) r = 1.f;
+					const float w = e.size * ds.x, h = w * r;
+					const ImVec2 p0(cx - w * 0.5f, cy - h * 0.5f), p1(cx + w * 0.5f, cy + h * 0.5f);
+					dl->AddRectFilled(p0, p1, IM_COL32(40, 120, 220, (int)(a * 0.35f)));
+					dl->AddRect(p0, p1, hot ? IM_COL32(255, 220, 60, 255) : IM_COL32(120, 180, 255, 220), 0.f, 0, hot ? 3.f : 1.5f);
+					const std::string t = "[picture] " + e.content;
+					const ImVec2 ts = ImGui::CalcTextSize(t.c_str());
+					dl->AddText(ImVec2(cx - ts.x * 0.5f, cy - ts.y * 0.5f), IM_COL32(255, 255, 255, 230), t.c_str());
+				}
+				else
+				{
+					const float em = std::max(8.0f, e.size * ds.y);
+					ImFont* font = ImGui::GetFont();
+					const ImVec2 ts = font->CalcTextSizeA(em, FLT_MAX, 0.f, e.content.c_str());
+					const ImVec2 pos(cx - ts.x * 0.5f, cy - ts.y * 0.5f);
+					const float sh = std::max(1.0f, em * 0.045f);
+					dl->AddText(font, em, ImVec2(pos.x + sh, pos.y + sh), IM_COL32(0, 0, 0, (int)(a * 0.8f)), e.content.c_str());
+					dl->AddText(font, em, pos,
+						IM_COL32((int)(e.color[0] * 255.f), (int)(e.color[1] * 255.f), (int)(e.color[2] * 255.f), a),
+						e.content.c_str());
+					if (hot) dl->AddRect(ImVec2(pos.x - 4, pos.y - 4), ImVec2(pos.x + ts.x + 4, pos.y + ts.y + 4), IM_COL32(255, 220, 60, 255), 0.f, 0, 2.f);
+				}
+			}
+		}
+
+		std::string label(const Entry& e)
+		{
+			std::string c = e.content.size() > 24 ? e.content.substr(0, 24) + "..." : e.content;
+			return std::string(e.picture ? "Picture: " : "Text: ") + c;
+		}
+	}
+
+	void display()
+	{
+		if (!g_loaded) { load(); refreshImages(); }
+		if (!ImGui::CollapsingHeader("Video overlay (text & pictures)"))
+		{
+			g_highlight = -1;
+			drawPreview();   // keep showing the layout with the section folded
+			return;
+		}
+
+		bool changed = false;
+		changed |= ImGui::Checkbox("Burn overlay into rendered video", &g_enabled);
+		ImGui::Checkbox("Show preview on screen (while this window is open)", &g_preview);
+		ImGui::TextDisabled("Text is shown as it will look. A picture shows as a blue box of the");
+		ImGui::TextDisabled("right size and place; the real picture appears in the rendered video.");
+		ImGui::TextDisabled("Close the ReShade window before pressing Export.");
+
+		ImGui::SeparatorText("Add text");
+		ImGui::InputText("##newtext", g_newText, sizeof(g_newText));
+		ImGui::SameLine();
+		if (ImGui::Button("Add text") && g_newText[0])
+		{
+			Entry e; e.content = g_newText; e.size = 0.05f; e.y = 0.9f;
+			g_entries.push_back(std::move(e));
+			g_newText[0] = '\0';
+			changed = true;
+		}
+
+		ImGui::SeparatorText("Add picture");
+		if (g_images.empty())
+		{
+			ImGui::TextWrapped("No pictures yet. Put .png / .jpg files in:");
+			ImGui::TextWrapped("%s", g_imageDir.c_str());
+		}
+		else
+		{
+			const char* cur = g_images[(size_t)g_pick].c_str();
+			if (ImGui::BeginCombo("##pic", cur))
+			{
+				for (int i = 0; i < (int)g_images.size(); ++i)
+					if (ImGui::Selectable(g_images[(size_t)i].c_str(), i == g_pick)) g_pick = i;
+				ImGui::EndCombo();
+			}
+			ImGui::SameLine();
+			if (ImGui::Button("Add picture"))
+			{
+				Entry e; e.picture = true; e.content = g_images[(size_t)g_pick]; e.size = 0.2f; e.x = 0.88f; e.y = 0.88f;
+				g_entries.push_back(std::move(e));
+				changed = true;
+			}
+		}
+		if (ImGui::Button("Refresh list")) refreshImages();
+		ImGui::SameLine();
+		if (ImGui::Button("Copy folder path")) ImGui::SetClipboardText(g_imageDir.c_str());
+
+		ImGui::SeparatorText("Entries");
+		if (g_entries.empty()) ImGui::TextDisabled("Nothing added yet.");
+
+		int del = -1;
+		g_highlight = -1;
+		for (int i = 0; i < (int)g_entries.size(); ++i)
+		{
+			Entry& e = g_entries[(size_t)i];
+			ImGui::PushID(i);
+			if (ImGui::TreeNode(label(e).c_str()))
+			{
+				g_highlight = i;
+				changed |= ImGui::Checkbox("Visible", &e.visible);
+				if (!e.picture)
+				{
+					char buf[256];
+					strncpy_s(buf, e.content.c_str(), sizeof(buf) - 1);
+					if (ImGui::InputText("Text", buf, sizeof(buf))) { e.content = buf; changed = true; }
+					changed |= ImGui::ColorEdit3("Colour", e.color, ImGuiColorEditFlags_NoInputs);
+				}
+				changed |= ImGui::SliderFloat("X", &e.x, 0.f, 1.f, "%.3f");
+				changed |= ImGui::SliderFloat("Y", &e.y, 0.f, 1.f, "%.3f");
+				if (e.picture) changed |= ImGui::SliderFloat("Width", &e.size, 0.02f, 1.f, "%.2f");
+				else           changed |= ImGui::SliderFloat("Text size", &e.size, 0.01f, 0.30f, "%.3f");
+				changed |= ImGui::SliderFloat("Opacity", &e.opacity, 0.05f, 1.f, "%.2f");
+				if (ImGui::Button("Delete")) del = i;
+				ImGui::TreePop();
+			}
+			ImGui::PopID();
+		}
+		if (del >= 0) { g_entries.erase(g_entries.begin() + del); changed = true; }
+
+		if (changed) save();
+		drawPreview();
+	}
+}
diff --git a/external/IgcsConnector-main/src/OverlayPanel.h b/external/IgcsConnector-main/src/OverlayPanel.h
