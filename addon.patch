@@ -0,0 +1,10 @@
+#pragma once
+
+// "Video overlay" section of the add-on's ReShade settings tab: add text and
+// pictures that Rockstar Editor+ burns into the rendered frames.
+// Writes <game>\RockstarEditorPlus\overlay\overlay.txt, read by the ASI.
+namespace overlaypanel
+{
+	// Call from displaySettings(), where the other CollapsingHeaders are.
+	void display();
+}
